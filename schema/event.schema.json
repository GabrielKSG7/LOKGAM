{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "event.schema.json",
  "title": "Event",
  "description": "Um fato datado na vida de um port: lançamento, notificação, remoção, queda. A tabela só cresce; um evento nunca é editado para virar outro.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "port_id", "date", "date_basis", "kind", "actor", "summary", "sources"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "port_id": { "description": "Ficha a que o evento se refere (ports.id).", "type": "string" },
    "date": {
      "description": "Data com a precisão conhecida: AAAA-MM ou AAAA-MM-DD.",
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}(-\\d{2})?$"
    },
    "date_basis": {
      "description": "occurred: dia em que o fato aconteceu. reported: dia em que foi noticiado, quando o dia do fato não é conhecido.",
      "enum": ["occurred", "reported"]
    },
    "kind": {
      "enum": ["launch", "dmca_notice", "removal", "outage", "restored", "model_change"]
    },
    "actor": { "description": "Quem agiu, quando se sabe.", "type": ["string", "null"] },
    "summary": { "type": "string", "minLength": 1 },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "url"],
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "format": "uri" }
        }
      }
    }
  }
}
